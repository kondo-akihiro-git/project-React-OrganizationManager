  "name": "テストメンバーさん",
  "title": "メンバー",
  "role": "member",
  "exists": true,
  "department_id": 10001,
  "manager_id": 20001,
  "team_id": 30001,
  "sub_manager_id": 40001,
  "leader_id": 50001
}

